rules_version = '2';

// One predicate for every collection: the caller's uid is in the workspace's
// `members` array. The four collections are flat siblings under the workspace,
// so a single recursive match covers events, buys, items and sells identically.
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(wsId) {
      return request.auth != null
        && request.auth.uid in
             get(/databases/$(database)/documents/workspaces/$(wsId)).data.members;
    }

    match /workspaces/{wsId} {
      // On create the workspace document does not exist yet, so isMember()
      // cannot read it — check the incoming payload instead.
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members;
      allow read, update: if isMember(wsId);
      allow delete: if false;

      // Everything beneath the workspace, at any depth.
      match /{document=**} {
        // Removing an item deletes it now, and takes its buy with it once that
        // buy is empty — REMOVED was the old exit and nothing writes it any
        // more. Refusing the delete here does not prevent it, it only makes it
        // fail late: Firestore takes the write into the local cache, the item
        // vanishes from the screen, and the phone puts it back on the next sync.
        // A sell whose item has gone is left unresolvable by design; the screens
        // read it as an unknown rather than assuming it is still there.
        allow read, create, update, delete: if isMember(wsId);
      }
    }
  }
}
