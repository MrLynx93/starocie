rules_version = '2';

// One predicate for every collection: the caller's uid is in the workspace's
// `members` array. The four collections are flat siblings under the workspace,
// so a single wildcard match covers events, buys, items and sells identically.
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(wsId) {
      return request.auth != null
        && request.auth.uid in
             get(/databases/$(database)/documents/workspaces/$(wsId)).data.members;
    }

    match /workspaces/{wsId} {
      // On create the workspace document does not exist yet, so isMember()
      // cannot read it — check the incoming payload instead.
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members;
      allow read, update, delete: if isMember(wsId);

      match /{collection}/{docId} {
        allow read, write: if isMember(wsId);
      }
    }
  }
}
